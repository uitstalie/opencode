#!/bin/bash
# 规则：dev 分支仅允许 sync 操作，禁止任何直接提交
BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$BRANCH" = "dev" ]; then
  echo "❌ dev 分支禁止直接提交！"
  echo ""
  echo "工作流："
  echo "  1. git checkout dev-ai       # 切换到开发分支"
  echo "  2. git rebase dev             # 拉上游最新"
  echo "  3. 修改代码、提交"
  echo "  4. git push origin dev-ai"
  echo ""
  echo "同步上游到 dev："
  echo "  git checkout dev"
  echo "  git fetch upstream dev"
  echo "  git rebase upstream/dev"
  echo "  git push origin dev"
  exit 1
fi
